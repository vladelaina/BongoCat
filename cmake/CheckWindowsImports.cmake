if(NOT EXISTS "${EXECUTABLE}" OR NOT EXISTS "${DUMPBIN}")
  message(FATAL_ERROR "Windows import audit requires an executable and dumpbin")
endif()
execute_process(COMMAND "${DUMPBIN}" /nologo /imports "${EXECUTABLE}"
  RESULT_VARIABLE status OUTPUT_VARIABLE imports ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Cannot inspect Windows imports: ${error}")
endif()
foreach(api SetWindowsHookExA SetWindowsHookExW CallNextHookEx
    UnhookWindowsHookEx AttachThreadInput)
  if(imports MATCHES "[ \t]${api}[ \t\r]*\n")
    message(FATAL_ERROR "Unused Windows capability reintroduced: ${api}")
  endif()
endforeach()
foreach(api RegisterRawInputDevices GetRawInputData)
  if(NOT imports MATCHES "[ \t]${api}[ \t\r]*\n")
    message(FATAL_ERROR "Required background input capability missing: ${api}")
  endif()
endforeach()
message(STATUS "Windows import audit passed: ${EXECUTABLE}")
